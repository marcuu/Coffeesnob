# Public site URL - used to build auth callback URLs.
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key - required by scoring and simulation scripts/routes.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token checked by POST /api/scoring/run.
SCORING_CRON_SECRET=

# Vercel Cron default bearer token. /api/simulation/tick also accepts
# SIMULATION_CRON_SECRET when you want a separate secret.
CRON_SECRET=
SIMULATION_CRON_SECRET=

# Bramford simulation review generation.
ANTHROPIC_API_KEY=
SIMULATION_MODEL=claude-sonnet-4-6
SIMULATION_MONTHLY_COST_CAP_USD=20
SIMULATION_ADMIN_EMAILS=

# Google OAuth credentials.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
